<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/marge_ecran"
    android:paddingTop="@dimen/espace_moyen"
    android:paddingEnd="@dimen/marge_ecran"
    android:paddingBottom="@dimen/espace_moyen">

    <TextView
        android:id="@+id/badge"
        android:layout_width="@dimen/taille_pastille"
        android:layout_height="@dimen/taille_pastille"
        android:gravity="center"
        android:textColor="@color/sur_pastille"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espace_moyen"
        android:layout_marginEnd="@dimen/espace_moyen"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/TexteLibelle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/details"
            style="@style/TexteSecondaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/king"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/texte_roi" />

</LinearLayout>